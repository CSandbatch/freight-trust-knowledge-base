# Copy to .env for local development. Never commit the populated .env file.

# AWS: prefer a named profile for local development. In CI or containers, prefer an
# attached IAM role/workload identity. Use static keys only when neither is available.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# OpenRouter: obtain a dedicated, least-privilege key and choose an explicit model slug.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_HTTP_REFERER=https://csandbatch.github.io/freight-trust-knowledge-base/
OPENROUTER_APP_NAME=Freight Trust Knowledge Base

# Public Hermes runtime. The gateway remains private on loopback; replit_server.py is
# the only browser-facing process and generates an ephemeral key when this is blank.
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=
API_SERVER_MODEL_NAME=hermes-agent
PUBLIC_SITE_URL=
BELLHILL_HERMES_HOME=
